# AWS Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# Environment Name (staging or production)
ENV_NAME=staging

# Duckling Configuration
DUCKLING_URL=http://127.0.0.1:8000/parse
DUCKLING_PORT=8000
DUCKLING_TIMEOUT=120

# API Configuration
PORT=8080

# Optional bearer token for /v1/intents/classify and /v1/suggestions/analyze.
# Leave unset to keep those routes open (health checks stay unauthenticated
# either way). When set, clients send: Authorization: Bearer <value>
# CLASSIFIER_API_KEY=

# Paths (for EC2 deployment)
DUCKLING_DIR=/root/workspace/duckling
NLP_DIR=/opt/scheduler0-nlp
DUCKLING_EXPORT_DIR=/opt/duckling
